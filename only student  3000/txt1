cd "/home/xtl/hst/only student  3000"

# -------------------- 训练第一阶段3000 epoch -------------------
sh script/train_motiondeblur.sh \
  --use_local_branch \
  --use_channel_aware \
  --double_process \
  --use_ddem \
  --ddem_stage 2 \
  --ddem_scratch_student \
  --ddem_kd_weight 0 \
  --kd_grad_stat_interval 0 \
  --ddem_dim 32 \
  --ddem_blocks 2 \
  --ddem_backbone local_global \
  --ddem_heads 1 \
  --ddem_win_size 8 \
  --adapter_warmup_epochs 0 \
  --backbone_lr_scale 1.0 \
  --lr_initial 0.0002 \
  --batch_size 8 \
  --train_ps 256 \
  --grad_clip 1.0 \
  --disable_validation \
  --checkpoint 1000 \
  --nepoch 3000 \
  --env _omni_stage_last_cam2x_lgddem_featurelocal_stageproj_onlystudent_scratch_equalLR_b8_e3000

# -------------------- 测试第一阶段最终模型 ---------------------
