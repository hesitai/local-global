# ============================================================
# Pure Blur DDEM：固定验证集的长期探路实验
# ============================================================
#
# 数据划分（原始440张不移动、不删除）：
#   训练：400对，20个完整序列
#   验证： 40对，2个完整序列
#
# 验证序列：
#   GOPR0386_11_00
#   GOPR0857_11_00
#
# 可复现的划分规则与目录说明：
# dataset/datasets/deblurring/GoPro/crop/validation_split_seed20260727.txt
#
# 本实验：
#   - 只输入Blur，从随机初始化训练；
#   - 不加载教师，不计算KD；
#   - 初始LR=3e-4，最长10000 epoch；
#   - 每100 epoch在固定40张验证集上验证一次；
#   - 每次验证追加到运行目录下的 validation_results.csv；
#   - 每1000 epoch保存一个永久checkpoint；
#   - model_best.pth保存验证PSNR最高的模型；
#   - model_latest.pth每100 epoch覆盖更新一次。
#
# 注意：最终1111张GoPro test没有参与训练、验证或超参数选择。
# ============================================================

cd "/home/xtl/hst/only student  3000"

sh script/train_motiondeblur.sh \
  --use_local_branch \
  --use_channel_aware \
  --double_process \
  --use_ddem \
  --ddem_stage 2 \
  --ddem_scratch_student \
  --ddem_kd_weight 0 \
  --kd_grad_stat_interval 0 \
  --ddem_dim 32 \
  --ddem_blocks 2 \
  --ddem_backbone local_global \
  --ddem_heads 1 \
  --ddem_win_size 8 \
  --adapter_warmup_epochs 0 \
  --backbone_lr_scale 1.0 \
  --lr_initial 0.0008 \
  --batch_size 8 \
  --train_ps 256 \
  --train_dir "dataset/datasets/deblurring/GoPro/crop/train_split" \
  --val_ps 256 \
  --val_dir "dataset/datasets/deblurring/GoPro/crop/val_split" \
  --val_epoch_interval 100 \
  --grad_clip 1.0 \
  --checkpoint 1000 \
  --nepoch 10000 \
  --env _omni_stage_last_cam2x_lgddem_featurelocal_stageproj_onlystudent_scratch_lr8e4_b8_e10000_val400_40


# ============================================================
