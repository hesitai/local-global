  --pretrain_weights "logs/motiondeblur/GoPro/Uformer_B_omni_stage_last_cam2x_lgddem_featurelocal_stageproj_onlystudent_scratch_lr8e4_b8_e10000_val400_40/models/model_latest.pth" \
  --env _omni_stage_last_cam2x_lgddem_featurelocal_stageproj_onlystudent_scratch_lr8e4_b8_e10000_val400_40


# ============================================================
